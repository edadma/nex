// FFT — radix-2 Cooley-Tukey, fixed N = 8
//
// A recursive discrete Fourier transform that exercises Nex's complex
// number support. Each `fft<N>` takes an N-element complex array and
// returns its DFT, decomposing into two N/2-sized sub-transforms plus a
// per-element twiddle combine. Sizes are hard-wired because the v0
// codegen doesn't yet ship a `fill(n, value)` / `zeros(n)` primitive
// for building variable-length complex arrays; a general FFT would slot
// in once that lands.
//
// Input: the step function [1, 1, 1, 1, 0, 0, 0, 0].
//
// The first output coefficient (DC term) is the sum of the inputs (= 4),
// so the printed value `Y[0] = 4.0 + 0.0i` is the easy sanity check.
//
// Run:    sbt "nexJVM/runMain io.github.edadma.nex.run run     examples/fft/main.nex"
// Build:  sbt "nexJVM/runMain io.github.edadma.nex.run compile examples/fft/main.nex"
//         ./examples/fft/main

def fft2(x: [complex]): [complex] =
  // Two-point DFT: trivial butterfly, no twiddle.
  [x[0] + x[1], x[0] - x[1]]

def fft4(x: [complex]): [complex] =
  // Split into even/odd two-point transforms, then combine with the
  // twiddle factors w_k = e^(-2πi k / 4) for k ∈ {0, 1}.
  val even = fft2([x[0], x[2]])
  val odd  = fft2([x[1], x[3]])
  val w0 = 1.0 + 0i           // e^(0)        =  1
  val w1 = 0.0 + (-1.0) * i   // e^(-π/2 · i) = -i
  val t0 = w0 * odd[0]
  val t1 = w1 * odd[1]
  [
    even[0] + t0, even[1] + t1,
    even[0] - t0, even[1] - t1
  ]

def fft8(x: [complex]): [complex] =
  // Same shape as fft4 with four twiddle factors w_k = e^(-2πi k / 8).
  // cos / sin come from libm via the prelude — see std §10.2.
  val even = fft4([x[0], x[2], x[4], x[6]])
  val odd  = fft4([x[1], x[3], x[5], x[7]])
  val w0 = cos(0.0)             + sin(0.0)             * i
  val w1 = cos(-pi / 4.0)       + sin(-pi / 4.0)       * i
  val w2 = cos(-pi / 2.0)       + sin(-pi / 2.0)       * i
  val w3 = cos(-3.0 * pi / 4.0) + sin(-3.0 * pi / 4.0) * i
  val t0 = w0 * odd[0]
  val t1 = w1 * odd[1]
  val t2 = w2 * odd[2]
  val t3 = w3 * odd[3]
  [
    even[0] + t0, even[1] + t1, even[2] + t2, even[3] + t3,
    even[0] - t0, even[1] - t1, even[2] - t2, even[3] - t3
  ]

def main() =
  val x = [
    1.0 + 0i, 1.0 + 0i, 1.0 + 0i, 1.0 + 0i,
    0.0 + 0i, 0.0 + 0i, 0.0 + 0i, 0.0 + 0i
  ]
  val y = fft8(x)
  print("FFT of [1, 1, 1, 1, 0, 0, 0, 0]:")
  for k in 0..8 do
    print(y[k])
